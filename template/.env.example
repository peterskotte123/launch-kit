BASE_URL=http://localhost:8000

# One Stripe account per business (all under one Stripe Organization / login). Test keys until launch.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen` locally, from the dashboard webhook in production

# One shared Supabase project for all apps: same DATABASE_URL everywhere, a different DB_SCHEMA per app.
DATABASE_URL=postgresql:///newthing    # Supabase: Project Settings > Database > connection string (session pooler)
DB_SCHEMA=newthing
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=                     # publishable/anon key; safe in the browser
# SUPABASE_JWT_SECRET=                 # only for legacy projects still signing with HS256
